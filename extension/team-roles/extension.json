{
    "id": "team-roles",
    "name": "Team management",
    "version": "1.1.0",
    "description": "Roles (Owner, Administrator, Moderator, Friend, User / Customer) with configurable rights, plus a support ticket system with notifications. By floiofficial.",
    "author": "floiofficial",
    "icon": "shield-check",
    "requires": {
        "panel": ">=2.0.0-dev <3.0",
        "php": "^8.3"
    },
    "provider": "TeamRoles\\TeamRolesProvider",
    "autoload": {
        "TeamRoles\\": "src"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "screens": [
            {
                "id": "team",
                "area": "admin",
                "path": "team",
                "nav": {
                    "label": "Team management",
                    "icon": "shield-check",
                    "order": 5
                }
            },
            {
                "id": "tickets",
                "area": "admin",
                "path": "tickets",
                "nav": {
                    "label": "Support tickets",
                    "icon": "life-buoy",
                    "order": 6
                }
            },
            {
                "id": "user-role",
                "area": "admin",
                "parent": "admin.user",
                "path": "role",
                "nav": {
                    "label": "Role",
                    "icon": "user-cog",
                    "order": 5
                }
            },
            {
                "id": "support",
                "area": "account",
                "path": "support",
                "nav": {
                    "label": "Support",
                    "icon": "life-buoy",
                    "order": 5
                }
            }
        ]
    }
}
